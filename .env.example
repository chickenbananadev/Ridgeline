# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# The Supabase publishable key is safe in frontend code ONLY because
# Row Level Security is enabled — see supabase/schema.sql.
VITE_SUPABASE_URL=https://wkvcsgzlsdidysoyzcwm.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me
VITE_GEOAPIFY_KEY=replace_me

# NEVER put the postgresql:// connection string here.
# It bypasses RLS and belongs server-side only.
